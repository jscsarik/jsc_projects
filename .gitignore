# ==============================================================================
# Global .gitignore for Antigravity Monorepo Workspace
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Environment Variables (Secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.token
*.token.txt
*토큰*.txt
*.pem
*.key
*.cert
*.pfx

# Allow example environment files
!.env.example
!.env.*.example

# ------------------------------------------------------------------------------
# Node.js & Next.js / Vite Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Python & PyInstaller Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# PyInstaller output directories
# (Note: .spec configuration files are tracked in version control)
build/
dist/

# Python execution logs
*.log
discord_mute_log.txt

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
